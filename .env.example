# =============================================================================
# Kitchen Copilot — environment template
# Copy to `.env.local` and fill in. Never commit the populated file.
# =============================================================================

# ----- MCP routing ----------------------------------------------------------
# `mock`  = read fake data from data/mock/*.json (default for local dev)
# `real`  = call live mcp.swiggy.com/{food,im,dineout} via OAuth
SWIGGY_MODE=mock

# Hard kill-switch on the three non-idempotent tools:
# place_food_order / checkout / book_table.
# Even when SWIGGY_MODE=real, these return DEMO_MODE_BLOCKED unless this is true.
LIVE_MUTATIONS=false

# ----- Swiggy MCP OAuth (only used when SWIGGY_MODE=real) -------------------
# Apply at https://mcp.swiggy.com/access — until approved, leave blank.
SWIGGY_CLIENT_ID=
SWIGGY_REDIRECT_URI=http://localhost:3000/api/auth/swiggy/callback

# ----- OpenAI Realtime (brain) ----------------------------------------------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# ----- Cartesia Sonic-2 (TTS voice) -----------------------------------------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-2
